+#[doc(hidden)]
 pub fn supply_analyze(env: &(impl Holds + ?Sized), implementation: Arc<dyn NotationAnalyze>) {
     env.hold(ANALYZER.into(), Arc::new(Analyzer(implementation)));
 }
