Subject: [PATCH 7/7] style(query): name the output errors' types by what
 error.rs imports

---
 rust/dialog-query/src/error.rs | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/rust/dialog-query/src/error.rs b/rust/dialog-query/src/error.rs
index 15ce5b149..2fca755d3 100644
--- a/rust/dialog-query/src/error.rs
+++ b/rust/dialog-query/src/error.rs
@@ -745,9 +745,9 @@ pub enum EvaluationError {
         /// The cell.
         cell: String,
         /// The type the cell declares.
-        expected: Box<crate::type_system::Type>,
+        expected: Box<Kind>,
         /// The value's own type.
-        actual: crate::corpus::Type,
+        actual: Type,
     },
 
     /// A formula an embedder supplies gave a row without a value for one
