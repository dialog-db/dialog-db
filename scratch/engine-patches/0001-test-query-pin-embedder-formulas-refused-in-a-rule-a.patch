+    assert!(
+        matches!(&refused, Err(TypeError::UnknownFormula { name }) if name == "test/whisper"),
+        "{refused:?}"
+    );
+    let unheld = applied(&Extensions::new(), "test/shout", "is");
+    assert!(
+        matches!(&unheld, Err(TypeError::UnknownFormula { name }) if name == "test/shout"),
