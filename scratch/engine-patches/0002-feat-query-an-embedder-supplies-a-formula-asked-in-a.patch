     }
 }
 
@@ -74,12 +86,29 @@ impl Application for PremiseQuery {
     where
         Env: crate::Scope<'a>,
     {
-        let _ = (&self.plan, &self.this, &self.select);
         (*self.plan).clone().evaluate(selection, env)
     }
 
     fn realize(&self, input: Match) -> Result<PremiseRow, EvaluationError> {
-        let _ = input;
-        todo!("PremiseQuery::realize")
+        let this = match input.value_of(&self.this) {
+            Some(Value::Entity(entity)) => entity.clone(),
+            Some(other) => {
+                return Err(EvaluationError::TypeMismatch {
+                    expected: ValueType::Entity,
+                    actual: other.data_type(),
+                });
+            }
+            None => {
+                return Err(EvaluationError::UnboundVariable {
+                    variable_name: self.this.clone(),
+                });
+            }
+        };
+        let values = self
+            .select
+            .iter()
+            .filter_map(|variable| Some((variable.clone(), input.value_of(variable)?.clone())))
+            .collect();
+        Ok(PremiseRow { this, values })
     }
 }
diff --git a/rust/dialog-query/src/rule/analyzer.rs b/rust/dialog-query/src/rule/analyzer.rs
index c02891222..65f41be7e 100644
--- a/rust/dialog-query/src/rule/analyzer.rs
+++ b/rust/dialog-query/src/rule/analyzer.rs
@@ -32,6 +32,7 @@ use crate::concept::descriptor::ConceptDescriptor;
 use crate::constraint::Constraint;
 use crate::corpus::Type as ValueType;
 use crate::error::{AnalysisError, TypeError};
+use crate::formula::FormulaQuery;
 use crate::planner::categorize;
 use crate::premise::Negation;
 use crate::proposition::Proposition;
@@ -421,6 +422,19 @@ pub fn analyze_with(
     kind: RuleKind,
     reduce: Vec<(String, ReduceSpec)>,
 ) -> Result<AnalyzedRule, AnalysisError> {
+    // No rule holds a formula an embedder supplies: a rule is stored and
+    // read back from its body, which cannot say the embedder's code.
+    if let Some(formula) = premises.iter().find_map(|premise| match premise {
+        Premise::Assert(Proposition::Formula(FormulaQuery::Extension(extension)))
+        | Premise::Unless(Negation(Proposition::Formula(FormulaQuery::Extension(extension)))) => {
+            Some(extension.name())
+        }
+        _ => None,
+    }) {
+        return Err(AnalysisError::EmbedderFormula {
+            formula: formula.to_string(),
+        });
+    }
     let head: Vec<(String, Kind)> = conclusion
         .with()
         .iter()
